# Server-only secrets. Never prefix these variables with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
COMPOSIO_API_KEY=
EXA_API_KEY=
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public canonical URL (safe for the browser).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hola, quiero información sobre Glocal Live.

# Future official ticketing provider. The MVP defaults to `mock`.
TICKETING_PROVIDER=mock
TICKETING_API_KEY=
TICKETING_PROVIDER_SECRET=
TICKETING_WEBHOOK_SECRET=
WEBHOOK_SECRET=

# Mercado Pago Checkout Pro. Set TICKETING_PROVIDER=mercado-pago to enable it.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_URL=
MERCADOPAGO_USE_SANDBOX=true

# Lead delivery through Resend. GLOCAL_FROM_EMAIL must use a verified domain.
RESEND_API_KEY=
GLOCAL_LEADS_EMAIL=eventos@glocal.live
GLOCAL_FROM_EMAIL=Glocal Live <leads@notifications.glocal.live>
